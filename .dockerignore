.git
.gitignore
# NB dockerignore patterns are anchored to the context root (unlike .gitignore),
# so nested caches (app/**/__pycache__, mcp_server/__pycache__) need the **/.
**/__pycache__/
**/*.pyc
**/*.pyo
.ruff_cache/
.pytest_cache/
.venv/
venv/
tests/
# Admin SPA: sources are copied into the node build stage; local artifacts and
# env files must never leak into either stage.
admin/node_modules/
admin/dist/
admin/.env
admin/.env.local
# Local retention media uploads never belong in the image (real media lives on
# the Railway Volume mounted at RETENTION_MEDIA_DIR).
media/
# Docs never ship in the image: nothing reads them at runtime (the root test
# page serves the static frontend/test.html; the old CLAUDE.md-rendering route
# is long gone).
*.md
